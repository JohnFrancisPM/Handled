# =====================================================================
# Handled Customer Experience — environment variables
# App: customer-app (dashboard + n8n + Supabase + Azure eval export)
# Each variable is listed ONCE. The "Used by" note says which
# sub-system(s) consume it. Copy the relevant lines into:
#   • Dashboard (apps/customer-app):  .env.local  (and Netlify env)
#   • n8n:                            n8n instance environment / credentials
#   • Azure eval:                     local shell / export tooling
# Values are empty on purpose (this is .env.example).
# =====================================================================

# ---------------------------------------------------------------------
# Supabase  (Settings > API)
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=            # Used by: dashboard (browser). Supabase project URL (safe in browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # Used by: dashboard (browser). anon/public key, RLS-enforced (safe in browser).
SUPABASE_URL=                        # Used by: n8n. Same project URL for n8n tool nodes. SERVER ONLY.
SUPABASE_SERVICE_ROLE_KEY=           # Used by: dashboard Route Handlers AND n8n. Bypasses RLS; org-scoping enforced in code. SERVER ONLY — never expose to the browser.

# ---------------------------------------------------------------------
# n8n webhook (shared secret must match on both sides)
# ---------------------------------------------------------------------
N8N_WEBHOOK_URL=                     # Used by: dashboard (reserved for a future "send test message"/outbound path). Full webhook URL, e.g. https://<n8n-host>/webhook/handled/message. SERVER ONLY.
N8N_WEBHOOK_SECRET=                  # Used by: dashboard (sends it) AND n8n (validates it) AND the Test Harness. Value of the X-Handled-Secret header. SERVER ONLY.

# ---------------------------------------------------------------------
# Anthropic Claude  (console.anthropic.com > API Keys) — set in n8n
# ---------------------------------------------------------------------
ANTHROPIC_API_KEY=                   # Used by: n8n. Claude API key. SERVER ONLY.
ANTHROPIC_MODEL_GUARD=               # Used by: n8n. Model id for spam/injection guard (Haiku-class), e.g. claude-haiku-4-5.
ANTHROPIC_MODEL_ROUTER=              # Used by: n8n. Model id for intent router (Haiku-class).
ANTHROPIC_MODEL_SPECIALIST=          # Used by: n8n. Model id for the 6 specialist agents (Sonnet-class), e.g. claude-sonnet-4-5.

# ---------------------------------------------------------------------
# Azure AI Foundry — eval scoring (optional; manual JSONL upload in demo)
# Only needed if you automate upload; the dashboard export also downloads a file.
# ---------------------------------------------------------------------
AZURE_AI_FOUNDRY_ENDPOINT=           # Used by: eval tooling. Azure AI Foundry project endpoint URL. SERVER ONLY.
AZURE_AI_FOUNDRY_API_KEY=            # Used by: eval tooling. Azure AI Foundry API key. SERVER ONLY.
AZURE_AI_FOUNDRY_PROJECT=            # Used by: eval tooling. Azure AI Foundry project/workspace name.

# ---------------------------------------------------------------------
# App config (dashboard)
# ---------------------------------------------------------------------
NEXT_PUBLIC_DEMO_ORG_SLUG=           # Used by: dashboard. Org slug loaded in read-only demo mode when a session/auth env is absent (e.g. acme-plumbing).
