# ---------------------------------------------------------------------------
# Test Harness — environment template.
# Copy to apps/test-harness/.env.local for local dev; set the same keys in the
# app's own Netlify site for production (see deployment.md).
#
# ALL variables here are SERVER ONLY. There are deliberately NO NEXT_PUBLIC_*
# variables: the browser never calls n8n directly and never sees the secret.
# The app builds and runs with NONE of these set (offline/demo-safe mode).
# ---------------------------------------------------------------------------

# n8n agentic webhook (the single external dependency)
N8N_WEBHOOK_URL=            # SERVER ONLY. Full webhook URL, e.g. https://<n8n-host>/webhook/handled/message
N8N_WEBHOOK_SECRET=         # SERVER ONLY — SECRET. Sent as the X-Handled-Secret header. Must equal the n8n workflow's N8N_WEBHOOK_SECRET. Never prefix NEXT_PUBLIC_.

# Target organization (the contract business_id)
ACME_BUSINESS_ID=acme-plumbing   # SERVER ONLY. Org slug the harness impersonates against. Defaults to acme-plumbing if unset.

# Demo-safety / tuning (all optional)
OFFLINE_MOCK=false          # SERVER ONLY. "true" => return canned mock replies when the webhook is unreachable or unconfigured, so a demo never hard-fails.
WEBHOOK_TIMEOUT_MS=60000    # SERVER ONLY. Per-request timeout (ms). Default 60000 — live webhook latency is ~19-49s, so do NOT lower below ~50000.
BATCH_CONCURRENCY=5         # SERVER ONLY. Max concurrent phone-groups during a batch run (HARD-CAPPED at 5 ⇒ never more than 5 webhook requests in flight). Same-phone scenarios are serialized within their group.
